{
  "name": "fiestime-backend-serverless",
  "version": "0.1.0",
  "private": true,
  "description": "fiestime serverless backend for uploading large multi-angle soccer videos to S3 via GraphQL on AWS Lambda + API Gateway.",
  "main": "dist/handlers/graphql.js",
  "scripts": {
    "build": "tsc",
    "build:lambda": "npm run build && npm run webpack:bundle",
    "webpack:bundle": "webpack --config webpack.config.js",
    "start:local": "ts-node-dev --respawn --transpile-only src/local/dev-server.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist coverage lambda-dist",
    "package": "npm run build:lambda && npm run package:zip",
    "package:zip": "cd lambda-dist && zip -r ../lambda-package.zip ."
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/aws-lambda": "^3.1.0",
    "aws-sdk": "^2.1672.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@shelf/jest-mongodb": "^4.2.0",
    "@types/aws-lambda": "^8.10.138",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "aws-sdk-mock": "^5.9.0",
    "babel-loader": "^9.1.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
