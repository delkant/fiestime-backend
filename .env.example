# fiestime Backend Environment Configuration

# Application Settings
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

# AWS Configuration
AWS_REGION=us-east-1
UPLOAD_BUCKET=my-fiestime-upload-bucket
PRESIGNED_URL_TTL_SECONDS=900

# MongoDB Configuration
# For local development, use direct URI:
MONGODB_URI=mongodb://localhost:27017/fiestime_development

# For Lambda deployment, use Secrets Manager:
# MONGODB_URI_SECRET_NAME=fiestime/sandbox/mongodb

# Optional: Enable debug logging for tests
# DEBUG_TESTS=true